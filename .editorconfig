root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# rustfmt uses four spaces; the web and config files use two.
[*.rs]
indent_size = 4

[{*.ts,*.tsx,*.js,*.jsx,*.mjs,*.cjs,*.json,*.css,*.html,*.yaml,*.yml}]
indent_size = 2
