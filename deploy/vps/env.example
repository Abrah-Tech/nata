# /etc/nata.env on the VPS (0600 root). The systemd units read it through
# EnvironmentFile; it is never baked into a release artifact.
#
# Runtime role: least privilege, RLS enforced by Postgres.
DATABASE_URL=postgresql://nata_app:CHANGE_ME@HOST/DB?sslmode=require
# Owner role: only the nata-migrate oneshot uses it (migrations + grants).
MIGRATE_DATABASE_URL=postgresql://OWNER:CHANGE_ME@HOST/DB?sslmode=require
# Must match the password inside DATABASE_URL; grant.sql re-applies it.
NATA_APP_PASSWORD=CHANGE_ME
# Random 32+ bytes. The API refuses nothing, but the dev default is public.
JWT_SECRET=CHANGE_ME
# Optional: the secret being rotated away from. Accepted for verification until
# every token signed with it expires (JWT_TTL_SECONDS), then removed. See
# "Rotasi JWT_SECRET" in README.md.
JWT_SECRET_PREV=
# Optional but recommended: pepper for OTP codes and invitation tokens. Without
# it the pepper falls back to JWT_SECRET, so rotating the signing secret also
# invalidates every pending code and invitation.
HASH_PEPPER=CHANGE_ME
PORT=3001
RUST_LOG=info,tower_http=info
