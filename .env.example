# nata-api
PORT=3001
DATABASE_URL=postgres://nata:nata@127.0.0.1:5432/nata
JWT_SECRET=dev-only-change-me
OTP_TTL_SECONDS=300
JWT_TTL_SECONDS=86400

# Public base URL used for links inside OTP and alert messages.
APP_URL=https://nata.arifinoid.web.id

# Fixed OTP for local sign-in. Debug builds use it instead of a random code,
# so any contact can sign in with it; release builds always randomize.
DEV_OTP_CODE=000000

# OTP delivery. Optional: with no provider configured, debug builds write the
# code to the log and release builds refuse to deliver.
# EMAIL_PROVIDER=brevo            # free 300/day, needs a verified sender
# BREVO_API_KEY=
# EMAIL_FROM=noreply@example.id
# EMAIL_FROM_NAME=Nata
# WHATSAPP_PROVIDER=fonnte        # free trial quota
# FONNTE_TOKEN=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public origin used for shared invitation links. Optional: without it the
# invite dialog offers only the raw code, because the Android WebView origin
# is not a URL a browser can open.
NEXT_PUBLIC_APP_URL=https://nata.arifinoid.web.id

# compose.yaml
POSTGRES_PORT=5432
